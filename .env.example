# Backend
DATABASE_URL=sqlite:///./data/essaytrace.db
JWT_SECRET=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: point at another OpenAI-compatible provider
OPENAI_BASE_URL=
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (copy this value to frontend/.env.local if it differs)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

